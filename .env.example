# iris-signal-harvester — environment template.
#
# Copy to .env (git-ignored) and adjust. Every variable is optional for `make demo`:
# the demo runs against committed fixtures and a throwaway local database container.
#
# The application deliberately has NO default for IRIS_DB_DSN. Secrets are read from the
# environment only and are never committed. Do not paste a real DSN into this file.

# --- local compose database (throwaway container; used by docker-compose.yml) -------------
# These values only create and reach the PostGIS container on 127.0.0.1. Use URL-safe
# characters in the password: it is interpolated into the DSN below.
IRIS_POSTGRES_USER=iris
IRIS_POSTGRES_PASSWORD=iris_local
IRIS_POSTGRES_DB=iris
# Host port the container's 5432 is published on (127.0.0.1 only).
IRIS_DB_HOST_PORT=5433

# --- database DSN for running the CLI or the integration tests on the host -----------------
# Left unset on purpose. For the compose database, `make test-integration` builds it for you;
# for anything else export it from your secret store, e.g.
#   IRIS_DB_DSN=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# IRIS_DB_DSN=

# --- source selection ----------------------------------------------------------------------
# fixture (default, offline) | oparl (live) | ratsdokumente (briefed endpoint; does not exist)
IRIS_SOURCE=fixture

# --- politeness ----------------------------------------------------------------------------
IRIS_RATE_LIMIT_RPS=1.0
IRIS_MAX_CONCURRENT_BODIES=4
IRIS_REQUEST_TIMEOUT_S=30
IRIS_MAX_RETRIES=4
# Must carry a contact address; it is how an operator can reach you instead of blocking you.
# Replace the address with your own before any live run.
IRIS_USER_AGENT="ProjectIris-Harvester/0.1 (+mailto:ops@example.org)"   # set a real contact before any live run
IRIS_RESPECT_ROBOTS=true

# --- incremental harvesting ----------------------------------------------------------------
IRIS_OVERLAP_HOURS=24
IRIS_MAX_PAGES_PER_BODY=500
IRIS_ZERO_YIELD_PAGES_BEFORE_STOP=2

# --- date and geo sanity -------------------------------------------------------------------
IRIS_MIN_PLAUSIBLE_YEAR=1990
IRIS_MAX_FUTURE_DAYS=400
IRIS_SOURCE_TIMEZONE=Europe/Berlin
IRIS_MUNICIPALITY_TOLERANCE_M=2000

# --- behaviour -----------------------------------------------------------------------------
# true in CI: any record-level rejection fails the run
IRIS_STRICT=false
IRIS_LOG_LEVEL=INFO
