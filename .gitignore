# Build artefacts, virtualenvs and local run output.
#
# Note what is deliberately NOT ignored: docs/samples/ and docs/evidence/ are committed
# on purpose - they are the sample output and the source evidence the assignment asks for.
# Only ./reports/ (regenerated on every run) is ignored.

__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.env
.env.*
!.env.example
reports/*
!reports/.gitkeep
.DS_Store
.superpowers/

# Committed evidence and sample output: these must stay
# tracked even though reports/ is ignored. The corpus cassettes live under tests/fixtures.
!docs/samples/
!docs/samples/**
!docs/evidence/
!docs/evidence/**
!tests/fixtures/cassettes/corpus/
!tests/fixtures/cassettes/corpus/**
